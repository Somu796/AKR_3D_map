    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Analysis & 3D Grid Generation\n",
        "\n",
        "### Burst counts\n",
        "#### Cartesian coordinates\n",
        "##### Calculating observation time and preaping plot file "
      ],
      "id": "50dad63e"
    },
    {
      "cell_type": "code",
      "metadata": {
        "source-line-numbers": "5,16,19,27,28"
      },
      "source": [
        "# 1. Importing Cartesian class from Package_Name\n",
        "from akr_3d_map.grid_3d import Cartesian\n",
        "\n",
        "# 2. Path to save the file\n",
        "plot_save_path = f\"{ASSETS_DIR}/cartesian_grid_with_burst_counts.json\"\n",
        "\n",
        "# 3. Performing analysis and generating plot\n",
        "cart = (\n",
        "    # Provide bin size for the 3D plot\n",
        "    Cartesian()\n",
        "    # In case you are not sure about the extreme points\n",
        "    # .decide_boundaries(wind_data)\n",
        "    # Create grid points\n",
        "    .create_grid()\n",
        "    # Calculate burst count given wind satellite data\n",
        "    .add_burst_count(wind_data, coord_colnames=(\"x_gse\", \"y_gse\", \"z_gse\"))\n",
        "    # Creating plot and saving as a json file (HPC save for big data)\n",
        "    .plot_3d(\n",
        "        variable=\"burst_count\",\n",
        "        path=plot_save_path,\n",
        "        show_earth=True,\n",
        "        earth_image_path_str=f\"{project_root}/assets/temp.jpg\",\n",
        "        show_sun=False,\n",
        "    )\n",
        ")\n",
        "\n",
        "# 4. Validation: Total time should be > 0\n",
        "total_burst_count = cart.grid.burst_count.sum().item()\n",
        "print(f\"Total observations time logged: {(total_burst_count):.1f} seconds\")"
      ],
      "id": "d9e919a6",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "##### Interactive Visualisation"
      ],
      "id": "a168441a"
    },
    {
      "cell_type": "code",
      "metadata": {
        "class": "dim-cell"
      },
      "source": [
        "import plotly.io as pio\n",
        "\n",
        "# Reload and display the 3D Interactive Map\n",
        "if Path(plot_save_path).exists():\n",
        "    cartesian_fig = pio.read_json(str(plot_save_path))\n",
        "    cartesian_fig.show()\n",
        "else:\n",
        "    print(f\"Error: Plot file not found at {plot_save_path}\")"
      ],
      "id": "49c6473d",
      "execution_count": null,
      "outputs": []
    },
